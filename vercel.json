{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://REEMPLAZA-TU-BACKEND.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://REEMPLAZA-TU-BACKEND.onrender.com/health"
    },
    {
      "source": "/((?!api/|health|assets/|manifest\\.webmanifest|sw\\.js|favicon\\.png).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
