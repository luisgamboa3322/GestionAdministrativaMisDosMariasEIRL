# --- Entorno general ---
APP_ENV=development
APP_NAME=Mis Dos Marias Document Manager
TIMEZONE=America/Lima

# --- Base de datos PostgreSQL ---
POSTGRES_USER=transportdocs
POSTGRES_PASSWORD=cambia_esta_clave_local
POSTGRES_DB=mis_dos_marias
DATABASE_URL=postgresql+psycopg://transportdocs:cambia_esta_clave_local@localhost:5433/mis_dos_marias

# --- Almacenamiento S3 privado (MinIO en desarrollo / Cloudflare R2 o Supabase Storage en nube) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=cambia_esta_clave_minio
S3_BUCKET_NAME=misdosmarias-docs
S3_USE_SSL=false
S3_AUTO_CREATE_BUCKET=true

# --- Seguridad y Sesiones ---
SESSION_SECRET_KEY=reemplaza_con_cadena_aleatoria_larga_de_64_caracteres
SESSION_COOKIE_NAME=mdm_session
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:8443,http://127.0.0.1:8443

# --- Cuenta inicial del Gerente General (solo bootstrap local) ---
INITIAL_ORG_NAME=MIS DOS MARÍAS E.I.R.L.
INITIAL_MANAGER_NAME=Gerente General
INITIAL_MANAGER_EMAIL=gerencia@misdosmarias.pe
INITIAL_MANAGER_PASSWORD=
